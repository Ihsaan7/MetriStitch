{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["./**/*.ts", "../src/config/*.ts", "../src/content/*.ts", "../src/lib/**/*.ts"],
  "exclude": ["../src/lib/content.ts", "../src/lib/env.ts"]
}
