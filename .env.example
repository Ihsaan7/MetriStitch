# Copy to .env.local for local work. On Cloudflare Pages set these under
# Settings > Variables and Secrets (production and preview separately).
# Never commit real values.

# --- Build-time, public (safe to expose in the browser) ---------------------
# Cloudflare Turnstile site key (public). Leave empty to hide the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Umami Cloud website ID (public). Leave empty to disable analytics.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Build-time control ------------------------------------------------------
# "production" turns on the PLACEHOLDER check and hides unfinished sections.
# On Cloudflare Pages this is set automatically when the branch is "main".
# METRISTITCH_ENV=production
