{
  "name": "metristitch-site",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing site and order form for an embroidery digitizing studio.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "check:data": "node scripts/check-data.mjs",
    "build": "node scripts/build.mjs",
    "build:production": "node scripts/build.mjs --production",
    "preview": "wrangler pages dev out --compatibility-date=2025-09-01",
    "images": "node scripts/optimize-images.mjs",
    "og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/newsreader": "^5.2.0",
    "marked": "^16.0.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250801.0",
    "@eslint/js": "^9.30.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.30.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.35.0",
    "wrangler": "^4.20.0"
  }
}
